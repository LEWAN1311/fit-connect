  "item": [
    {
      "name": "1. Gestion des cours",
      "item": [
        {
          "name": "POST Créer un cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yoga Flow\",\n  \"description\": \"Cours cree depuis Postman\",\n  \"instructor\": \"Marie\",\n  \"gymLocation\": \"Paris 11e\",\n  \"category\": \"YOGA\",\n  \"level\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 20,\n  \"price\": 15.0,\n  \"dateTime\": \"{{futureDate}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function fmt(d){const p=n=>String(n).padStart(2,'0');return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+'T'+p(d.getHours())+':'+p(d.getMinutes())+':00';}",
                  "pm.collectionVariables.set('futureDate', fmt(new Date(Date.now() + 72*3600*1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('classId', pm.response.json().id);",
                  "pm.test('SCHEDULED, 0 participant', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('SCHEDULED'); pm.expect(j.currentParticipants).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Lister les cours (pagination)",
          "request": {
            "method": "GET",
            "header": [],
